    {
        "id": "6e8ad76f696b1cd5",
        "type": "function",
        "z": "f353021935d92ed7",
        "name": "function 1",
        "func": "// 1. Grab the total energy used so far from the ESP32\nlet current_usage = msg.payload.total_kwh;\nlet daily_allowance = 5.0;\nlet Chip_Number = 1;\n\n// 2. Determine which Chip (Tier) you are currently in based on usage\nif (current_usage <= 5.0) {\n    daily_allowance = 5.0;\n    Chip_Number = 1;\n} else if (current_usage <= 10.0) {\n    daily_allowance = 10.0;\n    Chip_Number = 2;\n} else if (current_usage <= 20.0) {\n    daily_allowance = 20.0;\n    Chip_Number = 3;\n} else {\n    daily_allowance = 35.0;\n    Chip_Number = 4;\n}\n\n// 3. Calculate how much power is left before jumping to the NEXT chip\nlet remaining_power = daily_allowance - current_usage;\n\n// Prevent negative numbers if you somehow exceed the final 35 kWh chip\nif (remaining_power < 0) {\n    remaining_power = 0;\n}\n\n// 4. Send BOTH values forward by grouping them in an object (just like your ESP32 does)\nmsg.payload = {\n    remaining_kwh: parseFloat(remaining_power.toFixed(4)),\n    current_chip: Chip_Number\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 220,
        "wires": [
